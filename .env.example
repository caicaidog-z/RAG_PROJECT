# ============================================================
# 环境变量配置说明
# ------------------------------------------------------------
# 使用步骤：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 将下面各项替换为你的真实值（不要提交 .env 到 git）
#   3. 程序启动时由 utils/env_utils.py 通过 python-dotenv 自动加载
#
# 变量状态说明：
#   [必填]  缺失会导致功能不可用或启动失败
#   [可选]  有默认值或仅特定功能使用，可不填
# ============================================================


# ---------- 大模型 / LLM ----------
# 当前项目默认使用 DeepSeek 作为 LLM（见 llm_models/all_llm.py），
# 以下 OPENAI 相关项当前实际未启用（all_llm.py 中已注释），
# 如需切换回 OpenAI 兼容接口再填写。

# OpenAI API Key（当前未启用，切换到 OpenAI 时必填）
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key（必填，当前 LLM 使用 deepseek-chat）
# 申请地址：https://platform.deepseek.com  →  API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 使用的模型名称（OpenAI 兼容接口时必填；当前 DeepSeek 已在代码里硬编码为 deepseek-chat）
MODEL=your_model_name_here

# API 基础地址（OpenAI 兼容接口时必填；DeepSeek 地址已在代码里硬编码为 https://api.deepseek.com）
BASE_URL=your_base_url_here


# ---------- 向量数据库 ----------
# Milvus 向量数据库地址（必填，格式 host:port，如 127.0.0.1:19530）
MILVUS_URL=your_milvus_url_here


# ---------- 网络搜索 ----------
# Tavily Web Search API Key（web_search 路由必填）
# 申请地址：https://tavily.com  →  注册后在 Dashboard 获取 API Key（形如 tvly-xxx）
# 说明：新用户注册赠送 1000 credits（一次性，非每月续发），每次搜索约消耗 1~2 credits
# 若不想使用 Tavily，可将 all_llm.py 中的 web_search_tool 改为 DuckDuckGo（免 Key）
TAVILY_API_KEY=your_tavily_api_key_here


# ---------- 文档抓取源 ----------
# Confluence 抓取源（可选，仅 confluence_fetcher.py 使用）
# Confluence 站点地址（不填时默认使用下方地址）
CONFLUENCE_BASE_URL=https://wiki2.rd.chanjet.com

# Confluence 访问令牌（仅在抓取 Confluence 文档时需要）
# 获取方式：登录 Confluence → 个人头像 → 设置 → 个人访问令牌（Personal Access Token）
CONFLUENCE_TOKEN=your_confluence_token_here
